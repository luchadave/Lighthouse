function getYouTubeVideoId(post: Post): string | null {
  const contentUrls = post.content.match(/https?:\/\/[^\s<>"']+/g) ?? [];
  const candidates = [
    post.card?.url ?? '',
    ...contentUrls
  ];

  for (const candidate of candidates) {
    try {
      const url = new URL(candidate);
      const host = url.hostname.toLowerCase().replace(/^www\./, '');

      let videoId = '';

      if (host === 'youtu.be') {
        videoId = url.pathname.split('/').filter(Boolean)[0] ?? '';
      } else if (
        ['youtube.com', 'm.youtube.com', 'music.youtube.com', 'youtube-nocookie.com'].includes(host)
      ) {
        if (url.pathname === '/watch') {
          videoId = url.searchParams.get('v') ?? '';
        } else {
          const match = url.pathname.match(/^\/(?:shorts|embed|live)\/([^/?]+)/);
          videoId = match?.[1] ?? '';
        }
      }

      if (/^[A-Za-z0-9_-]{11}$/.test(videoId)) {
        return videoId;
      }
    } catch {
      // Ignore URLs that cannot be parsed.
    }
  }

  return null;
}
