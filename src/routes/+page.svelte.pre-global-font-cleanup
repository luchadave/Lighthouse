$effect(() => {
  if (!data.account || activeNav !== 'Home') return;

  const initialPosts = data.posts;
  const controller = new AbortController();
  let refreshing = false;

  async function refreshHome() {
    if (refreshing || document.hidden) return;
    refreshing = true;

    const sinceId = pendingHomePosts[0]?.id ?? posts[0]?.id;
    const existingIds = new Set([...pendingHomePosts, ...posts].map(post => post.id));
    const newPosts: Post[] = [];
    const seenCursors = new Set<string>();
    const params = new URLSearchParams();
    if (sinceId) params.set('since_id', sinceId);

    try {
      const signal = AbortSignal.any([controller.signal, AbortSignal.timeout(15_000)]);
      let firstPageCursor: string | null = null;

      while (true) {
        const response = await fetch(`/api/timeline?${params}`, { signal });
        if (!response.ok) return;

        const result: { posts: Post[]; nextMaxId: string | null } = await response.json();
        if (!params.has('max_id')) firstPageCursor = result.nextMaxId;

        for (const post of result.posts) {
          if (existingIds.has(post.id)) continue;
          existingIds.add(post.id);
          newPosts.push(post);
        }

        const cursor = result.nextMaxId;
        if (!sinceId || !cursor || result.posts.length === 0) break;
        if (seenCursors.has(cursor)) return;
        seenCursors.add(cursor);
        params.set('max_id', cursor);
      }

      if (signal.aborted || data.posts !== initialPosts || newPosts.length === 0) return;
      if (!sinceId) nextMaxId = firstPageCursor;

      pendingHomePosts = [...newPosts, ...pendingHomePosts];
      showNewHomePostsAtTop();
    } catch {
      // Keep the current feed available and retry on the next check.
    } finally {
      refreshing = false;
    }
  }

  const interval = window.setInterval(refreshHome, homeRefreshInterval);
  document.addEventListener('visibilitychange', refreshHome);
  window.addEventListener('scroll', showNewHomePostsAtTop, { passive: true });

  return () => {
    controller.abort();
    window.clearInterval(interval);
    document.removeEventListener('visibilitychange', refreshHome);
    window.removeEventListener('scroll', showNewHomePostsAtTop);
  };
});

function showNewHomePostsAtTop() {
  if (!document.hidden && window.scrollY <= 0 && pendingHomePosts.length > 0) {
    showNewHomePosts();
  }
}

function showNewHomePosts() {
  const existingIds = new Set(posts.map(post => post.id));
  posts = [...pendingHomePosts.filter(post => !existingIds.has(post.id)), ...posts];
  pendingHomePosts = [];
  window.scrollTo({ top: 0, behavior: 'instant' });
}

// Track the newest notification seen by this account in this browser.
$effect(() => {
  const accountKey = data.account?.acct;
  if (!accountKey) return;

  const storageKey = `noctiluna:last-seen-notification:${accountKey}`;
  const latestNotificationTime = notifications.reduce((latest, notification) => {
    const createdAt = Date.parse(notification.created_at);
    return Number.isFinite(createdAt) ? Math.max(latest, createdAt) : latest;
  }, 0);
  const storedLastSeen = localStorage.getItem(storageKey);

  // On first use, establish a baseline rather than flagging the whole inbox.
  if (storedLastSeen === null) {
    localStorage.setItem(storageKey, String(latestNotificationTime));
    hasNewNotifications = false;
    return;
  }

  hasNewNotifications = latestNotificationTime > (Number(storedLastSeen) || 0);
});

function markNotificationsSeen() {
  const accountKey = data.account?.acct;
  if (!accountKey) return;

  const latestNotificationTime = notifications.reduce((latest, notification) => {
    const createdAt = Date.parse(notification.created_at);
    return Number.isFinite(createdAt) ? Math.max(latest, createdAt) : latest;
  }, 0);
  const storageKey = `noctiluna:last-seen-notification:${accountKey}`;
  const previousLastSeen = Number(localStorage.getItem(storageKey)) || 0;
  localStorage.setItem(storageKey, String(Math.max(previousLastSeen, latestNotificationTime)));
  hasNewNotifications = false;
}

let searchController: AbortController | null = null;

async function performSearch() {
  const query = searchQuery.trim();

  if (!query) {
    searchResults = {
      accounts: []
    };
    searchError = '';
    return;
  }

  searchController?.abort();
  searchController = new AbortController();

  searching = true;
  searchError = '';

  try {
    const params = new URLSearchParams({
      q: query,
      type: 'accounts'
    });

    const response = await fetch(
      `/api/search?${params.toString()}`,
      { signal: searchController.signal }
    );

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.error || 'Search failed.');
    }

    searchResults = {
      accounts: result.accounts ?? []
    };
  } catch (error) {
    if (error instanceof Error && error.name === 'AbortError') {
      return;
    }

    searchError =
      error instanceof Error ? error.message : 'Search failed.';
  } finally {
    if (!searchController?.signal.aborted) {
      searching = false;
    }
  }
}

async function toggleAccountFollow(account: SearchAccount) {
  if (processingAccounts.includes(account.id)) return;

  const relationship = account.relationship;
  const action =
    relationship?.following || relationship?.requested
      ? 'unfollow'
      : 'follow';

  processingAccounts = [...processingAccounts, account.id];
  accountFollowError = '';

  try {
    const response = await fetch(
      `/api/accounts/${encodeURIComponent(account.id)}/follow`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ action })
      }
    );

    const result = await response.json().catch(() => null);

    if (!response.ok) {
      throw new Error(
        result?.error || 'Could not update follow relationship.'
      );
    }

    searchResults = {
      ...searchResults,
      accounts: searchResults.accounts.map(item =>
        item.id === account.id
          ? { ...item, relationship: result.relationship }
          : item
      )
    };
  } catch (error) {
    accountFollowError =
      error instanceof Error
        ? error.message
        : 'Could not update follow relationship.';
  } finally {
    processingAccounts = processingAccounts.filter(
      id => id !== account.id
    );
  }
}

async function loadBookmarks() {
  if (loadingBookmarks || bookmarksLoaded) return;

  loadingBookmarks = true;
  bookmarksError = '';

  try {
    const response = await fetch('/api/bookmarks');

    if (!response.ok) {
      throw new Error('Unable to load bookmarks.');
    }

    const result: {
      posts: Post[];
      nextMaxId: string | null;
    } = await response.json();

    bookmarkedPosts = result.posts;
    bookmarksNextMaxId = result.nextMaxId;
    bookmarksLoaded = true;
  } catch (error) {
    bookmarksError =
      error instanceof Error
        ? error.message
        : 'Unable to load bookmarks.';
  } finally {
    loadingBookmarks = false;
  }
}

async function loadMoreBookmarks() {
  if (!bookmarksNextMaxId || loadingBookmarks) return;

  loadingBookmarks = true;
  bookmarksError = '';

  try {
    const response = await fetch(
      `/api/bookmarks?max_id=${encodeURIComponent(bookmarksNextMaxId)}`
    );

    if (!response.ok) {
      throw new Error('Unable to load older bookmarks.');
    }

    const result: {
      posts: Post[];
      nextMaxId: string | null;
    } = await response.json();

    const existingIds = new Set(
      bookmarkedPosts.map(post => post.id)
    );

    const newPosts = result.posts.filter(
      post => !existingIds.has(post.id)
    );

    bookmarkedPosts = [...bookmarkedPosts, ...newPosts];
    bookmarksNextMaxId = result.nextMaxId;
  } catch (error) {
    bookmarksError =
      error instanceof Error
        ? error.message
        : 'Unable to load older bookmarks.';
  } finally {
    loadingBookmarks = false;
  }
}


