async function deletePost(post: Post) {
  openPostMenu = null;

  if (deletingPosts.includes(post.id)) return;
  if (!window.confirm('Delete this post? This cannot be undone.')) return;

  deletingPosts = [...deletingPosts, post.id];
  publishError = '';
  publishSuccess = '';

  try {
    const response = await fetch(`/api/statuses/${encodeURIComponent(post.id)}`, {
      method: 'DELETE'
    });
    const result = await response.json().catch(() => null);

    if (!response.ok) {
      throw new Error(result?.error || 'Could not delete the post.');
    }

    posts = posts.filter(item => item.id !== post.id);
profilePosts = profilePosts.filter(item => item.id !== post.id);
    publishSuccess = 'Post deleted.';
    if (publishNoticeTimeout) clearTimeout(publishNoticeTimeout);
    publishNoticeTimeout = setTimeout(() => publishSuccess = '', 4000);
  } catch (error) {
    publishError = error instanceof Error ? error.message : 'Could not delete the post.';
  } finally {
    deletingPosts = deletingPosts.filter(id => id !== post.id);
  }
}

async function publishPost() {
  if (
    publishing ||
    !composeText.trim()
  ) {
    return;
  }

  publishing = true;
  publishError = '';
  publishSuccess = '';

  try {
    const mediaIds: string[] = [];

    for (let index = 0; index < composeAttachments.length; index++) {
      const file = composeAttachments[index];
      if (!file) continue;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('description', attachmentAltText[index] ?? '');

      const uploadResponse = await fetch('/api/media', {
        method: 'POST',
        body: formData
      });

      const uploadResult = await uploadResponse.json().catch(() => null);

      if (!uploadResponse.ok || !uploadResult?.media?.id) {
        throw new Error(
          uploadResult?.error || `Could not upload ${file.name}.`
        );
      }

      mediaIds.push(uploadResult.media.id);
    }

    const allMediaIds = [...existingMediaIds, ...mediaIds];
    const wasEditing = editingPost !== null;
    const endpoint = editingPost
      ? `/api/statuses/${encodeURIComponent(editingPost.id)}`
      : '/api/statuses';

    const response = await fetch(endpoint, {
      method: wasEditing ? 'PUT' : 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        status: composeText.trim(),
        ...(wasEditing ? {} : { visibility: composeVisibility }),
        spoiler_text: showContentWarning
          ? contentWarning.trim()
          : '',
        media_ids: allMediaIds,
        ...(pollEnabled
  ? {
      poll: {
        options: pollOptions,
        expires_in: pollDuration,
        multiple: pollMultiple
      }
    }
  : {}),
        ...(replyingTo
          ? { in_reply_to_id: replyingTo.id }
                    : {}),
          ...(quotingPost
  ? { quoted_status_id: quotingPost.id }
  : {})
      })
    });

    const result = await response.json().catch(() => null);

    if (!response.ok) {
      throw new Error(
        result?.error || 'Could not publish the post.'
      );
    }

    const wasReply = replyingTo !== null;
const wasQuote = quotingPost !== null;

replyingTo = null;
quotingPost = null;
    editingPost = null;
    existingMediaIds = [];
    activeNav = 'Home';
    composeText = '';
    contentWarning = '';
    showContentWarning = false;
    composeAttachments = [];
    attachmentAltText = [];
    pollEnabled = false;
    pollOptions = ['', ''];
    pollMultiple = false;
    pollDuration = 86400;

    publishSuccess = wasEditing
  ? 'Post updated.'
  : wasReply
    ? 'Reply published.'
    : wasQuote
      ? 'Quote published.'
      : 'Post published.';

    if (publishNoticeTimeout) {
      clearTimeout(publishNoticeTimeout);
    }

    publishNoticeTimeout = setTimeout(() => {
      publishSuccess = '';
    }, 4000);

    invalidateAll();
  } catch (error) {
    publishError =
      error instanceof Error
        ? error.message
        : 'Something went wrong while publishing.';
  } finally {
    publishing = false;
  }
}
