{#if activeNav === 'Home' ||
  activeNav === 'Profile' ||
  activeNav === 'Bookmarks' ||
  activeNav === 'Lists' ||
  activeNav === 'Hashtags'}

        <div class="timeline">
{#if activeNav === 'Home' && pendingHomePosts.length > 0}
  <div class="new-home-posts">
    <button class="load-more-button" type="button" onclick={showNewHomePosts}>
      Show {pendingHomePosts.length} new {pendingHomePosts.length === 1 ? 'post' : 'posts'}
    </button>
  </div>
{/if}
{#if activeNav === 'Profile' && data.account}
  <section class="profile-view">
    <div class="profile-banner">
      {#if data.account.header}
        <img src={data.account.header} alt="" />
      {/if}
    </div>

    <div class="profile-details">
      <img
        class="profile-avatar"
        src={data.account.avatar}
        alt=""
      />

      <h2>{data.account.displayName}</h2>
      <p class="profile-handle">@{data.account.acct}</p>

      {#if data.account.note}
        <p class="profile-bio">{data.account.note}</p>
      {/if}

      <div class="profile-stats">
        <div>
          <strong>{data.account.followingCount}</strong>
          <span>Following</span>
        </div>
        <div>
          <strong>{data.account.followersCount}</strong>
          <span>Followers</span>
        </div>
        <div>
          <strong>{data.account.statusesCount}</strong>
          <span>Posts</span>
        </div>
      </div>

      {#if data.account.fields.length > 0}
        <div class="profile-fields">
          {#each data.account.fields as field}
            <div class="profile-field">
              <strong>{field.name}</strong>
              <span>{@html field.value}</span>
            </div>
          {/each}
        </div>
      {/if}

      <a
        class="profile-link"
        href={data.account.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        View profile on Hollo
      </a>
    </div>
  </section>
{/if}

{#if activeNav === 'Bookmarks'}
  {#if loadingBookmarks && bookmarkedPosts.length === 0}
    <p class="timeline-error">Loading bookmarks…</p>
  {:else if bookmarksError}
    <p class="timeline-error">{bookmarksError}</p>
  {:else if bookmarksLoaded && bookmarkedPosts.length === 0}
    <p>No bookmarks yet.</p>
  {/if}
{/if}

{#if activeNav === 'Lists'}
  {#if loadingListPosts && listPosts.length === 0}
    <p class="timeline-error">Loading list posts…</p>
  {:else if listTimelineError}
    <p class="timeline-error">{listTimelineError}</p>
  {:else if selectedListId && listPosts.length === 0}
    <p>No posts in this list yet.</p>
  {/if}
{/if}

{#if activeNav === 'Hashtags'}
  {#if loadingHashtagPosts && hashtagPosts.length === 0}
    <p class="timeline-error">Loading hashtag posts…</p>
  {:else if hashtagTimelineError}
    <p class="timeline-error">{hashtagTimelineError}</p>
  {:else if selectedHashtag && hashtagPosts.length === 0}
    <p class="timeline-error">No posts found for #{selectedHashtag}.</p>
  {/if}
{/if}

{#each (
  activeNav === 'Profile'
    ? profilePosts
    : activeNav === 'Bookmarks'
      ? bookmarkedPosts
      : activeNav === 'Lists'
        ? listPosts
        : activeNav === 'Hashtags'
          ? hashtagPosts
          : posts
) as post (post.id)}
          {@const youtubeVideoId = getYouTubeVideoId(post)}
            <article class="post-card">
                    <div class="post-avatar-column">
  <a
    class="post-profile-avatar"
    href={post.url}
    aria-label={`View ${post.name}'s profile`}
  >
    <img
      class="post-avatar"
      src={post.avatar}
      alt=""
    />
  </a>
  <div class="timeline-line"></div>
</div>

              <div class="post-content">
{#if post.boostedBy}
    <div class="boost-attribution">
      <Repeat2 size={14} />
      <span>Reposted by {post.boostedBy}</span>
    </div>
  {/if}
                <div class="post-header">
                  <a class="post-author" href={post.url}>
  <strong>{post.name}</strong>
  <span>{post.handle}</span>
</a>
                  <div class="post-meta">
                    {new Date(post.time).toLocaleString()}
                    {#if post.isOwnPost}
                      <div class="post-menu-wrap">
                        <button
                          class="more-button"
                          type="button"
                          aria-label="More post actions"
                          aria-expanded={openPostMenu === post.id}
                          onclick={() => openPostMenu = openPostMenu === post.id ? null : post.id}
                        >
                          <Ellipsis size={20} strokeWidth={1.8} />
                        </button>
                        {#if openPostMenu === post.id}
                          <div class="post-menu">
                            <button type="button" onclick={() => startEdit(post)}>Edit post</button>
                            <button
                              type="button"
                              class="delete-post-action"
                              disabled={deletingPosts.includes(post.id)}
                              onclick={() => deletePost(post)}
                            >
                              {deletingPosts.includes(post.id) ? 'Deleting…' : 'Delete post'}
                            </button>
                          </div>
                        {/if}
                      </div>
                    {/if}
                  </div>
                </div>

                <div class="post-text" use:highlightCode>
  {@html post.content}
</div>

{#if post.poll}
  {@const poll = post.poll}
  <div class="post-poll">
    {#if poll.voted || poll.expired}
      <div class="poll-results">
        {#each poll.options as option, index}
          {@const votes = option.votes_count ?? 0}
          {@const percentage = poll.votes_count > 0
            ? Math.round((votes / poll.votes_count) * 100)
            : 0}

          <div class="poll-result">
            <div class="poll-result-label">
              <span>{option.title}</span>
              <strong>{percentage}%</strong>
            </div>

            <div class="poll-result-track">
              <div
                class="poll-result-fill"
                style={`width: ${percentage}%`}
              ></div>
            </div>
          </div>
        {/each}
      </div>
    {:else}
      <div class="poll-choices">
        {#each poll.options as option, index}
          <label class="poll-choice">
            <input
              type={poll.multiple ? 'checkbox' : 'radio'}
              name={`poll-${poll.id}`}
              checked={selectedPollOptions[poll.id]?.includes(index) ?? false}
              disabled={votingPolls.includes(poll.id)}
              onchange={() => {
                const current = selectedPollOptions[poll.id] ?? [];

                selectedPollOptions = {
                  ...selectedPollOptions,
                  [poll.id]: poll.multiple
                    ? current.includes(index)
                      ? current.filter(choice => choice !== index)
                      : [...current, index]
                    : [index]
                };
              }}
            />
            <span>{option.title}</span>
          </label>
        {/each}
      </div>

      <button
        class="poll-vote-button"
        type="button"
        disabled={
          votingPolls.includes(poll.id) ||
          !(selectedPollOptions[poll.id]?.length)
        }
        onclick={() => voteInPoll(post.id)}
      >
        {votingPolls.includes(poll.id) ? 'Voting…' : 'Vote'}
      </button>

      {#if pollErrors[poll.id]}
        <p class="poll-error">{pollErrors[poll.id]}</p>
      {/if}
    {/if}

    <div class="poll-footer">
      <span>{poll.votes_count} votes</span>
      <span>{poll.multiple ? 'Multiple choice' : 'Single choice'}</span>
      <span>{poll.expired ? 'Poll ended' : 'Poll open'}</span>
    </div>
  </div>
{/if}

{#if post.quotedPost}
  <div class="quoted-post">
    <div class="quoted-post-header">
      <img
        src={post.quotedPost.avatar}
        alt=""
        class="quoted-post-avatar"
      />
      <div class="quoted-post-author">
        <strong>{post.quotedPost.name}</strong>
        <span>{post.quotedPost.handle}</span>
      </div>
      <span class="quoted-post-time">
        {new Date(post.quotedPost.time).toLocaleDateString()}
      </span>
    </div>

    <div class="quoted-post-content">
      {@html post.quotedPost.content}
    </div>
  </div>
{/if}
                {#if post.mediaAttachments.length > 0}
                  <div class="post-media">
                    {#each post.mediaAttachments as attachment (attachment.id)}
{#if attachment.type === 'image'}
  <div class="post-media-item">
    <button
      type="button"
      class="post-media-button"
      aria-label="Enlarge image"
      onclick={() => openImage(attachment.url ?? attachment.preview_url ?? '')}
    >
      <img
        class="post-media-image"
        src={attachment.preview_url ?? attachment.url ?? ''}
        alt={attachment.description ?? ''}
        loading="lazy"
      />
    </button>

    {#if attachment.description}
      <button
        class="alt-text-toggle"
        type="button"
        aria-expanded={!!visibleAltText[attachment.id]}
        onclick={() => {
          visibleAltText = {
            ...visibleAltText,
            [attachment.id]: !visibleAltText[attachment.id]
          };
        }}
      >
        {visibleAltText[attachment.id] ? 'Hide alt text' : 'Show alt text'}
      </button>

      {#if visibleAltText[attachment.id]}
        <p class="post-media-alt-text">{attachment.description}</p>
      {/if}
    {/if}
  </div>
{:else if attachment.type === 'video' || attachment.type === 'gifv'}
  <div class="post-media-item">
    <video
      class="post-media-video"
      src={attachment.url ?? undefined}
      poster={attachment.preview_url ?? undefined}
      controls
      playsinline
      preload="metadata"
    >
      <track kind="captions" />
    </video>

    {#if attachment.description}
      <button
        class="alt-text-toggle"
        type="button"
        aria-expanded={!!visibleAltText[attachment.id]}
        onclick={() => {
          visibleAltText = {
            ...visibleAltText,
            [attachment.id]: !visibleAltText[attachment.id]
          };
        }}
      >
        {visibleAltText[attachment.id] ? 'Hide alt text' : 'Show alt text'}
      </button>

      {#if visibleAltText[attachment.id]}
        <p class="post-media-alt-text">{attachment.description}</p>
      {/if}
    {/if}
  </div>
{/if}                    {/each}
                  </div>
                {/if}

                {#if youtubeVideoId}
  <div class="youtube-preview">
    {#if playingYouTube === youtubeVideoId}
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}?autoplay=1`}
        title="YouTube video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    {:else}
      <button
        class="youtube-thumbnail"
        type="button"
        onclick={() => playYouTube(youtubeVideoId)}
        aria-label="Play YouTube video"
      >
        <img
          src={`https://i.ytimg.com/vi/${youtubeVideoId}/hqdefault.jpg`}
          alt="YouTube video thumbnail"
          loading="lazy"
        />
        <span class="youtube-play-button">▶</span>
      </button>
    {/if}
  </div>
{:else if post.card}
  <a
    class="link-preview"
    href={post.card.url}
    target="_blank"
    rel="noopener noreferrer"
  >
    {#if post.card.image}
      <img
        class="link-preview-image"
        src={post.card.image}
        alt=""
        loading="lazy"
      />
    {/if}

    <div class="link-preview-content">
      {#if post.card.provider_name}
        <span class="link-preview-provider">
          {post.card.provider_name}
        </span>
      {/if}

      <strong>{post.card.title}</strong>

      {#if post.card.description}
        <p>{post.card.description}</p>
      {/if}

      <span class="link-preview-url">
        {post.card.url}
      </span>
    </div>
  </a>
{/if}

                <div class="post-actions">

                  <button
                    class:liked={post.liked}
                    class="action-button"
                    aria-label="Favourite"
                    aria-pressed={post.liked}
                    disabled={processingLikes.includes(post.id)}
                    aria-busy={processingLikes.includes(post.id)}
                    onclick={() => toggleLike(post.id)}
                  >
                    <Heart
                      class="action-icon"
                      size={19}
                      strokeWidth={1.8}
                      fill={post.liked ? 'currentColor' : 'none'}
                    />
                  </button>

                  <button
                    class="action-button"
                    type="button"
                    aria-label="Reply"
                    onclick={() => startReply(post)}
                  >
                    <MessageCircle class="action-icon" size={19} strokeWidth={1.8} />
                    {#if post.replies > 0}
                      <span class="action-count">{post.replies}</span>
                    {/if}
                  </button>

                  <button
                    class:reposted={post.reposted}
                    class="action-button"
                    aria-label={post.reposted ? 'Undo repost' : 'Repost'}
                    aria-pressed={post.reposted}
                    disabled={processingReposts.includes(post.id)}
                    aria-busy={processingReposts.includes(post.id)}
                    onclick={() => toggleRepost(post.id)}
                  >
                    <Repeat2 class="action-icon" size={19} strokeWidth={1.8} />
                    <span class="action-count">{post.reposts}</span>
                  </button>

<button
  class="action-button"
  type="button"
  aria-label="Quote"
  onclick={() => startQuote(post)}
>
  <Quote class="action-icon" size={19} strokeWidth={1.8} />
</button>

                  <button
                    class:bookmarked={post.bookmarked}
                    class="action-button"
                    aria-label="Bookmark"
                    aria-pressed={post.bookmarked}
                    disabled={processingBookmarks.includes(post.id)}
                    aria-busy={processingBookmarks.includes(post.id)}
                    onclick={() => toggleBookmark(post.id)}
                  >
                    <Bookmark
                      class="action-icon"
                      size={19}
                      strokeWidth={1.8}
                      fill={post.bookmarked ? 'currentColor' : 'none'}
                    />
                  </button>

                  <button
  class="action-button share-action"
  aria-label="Share"
  type="button"
  onclick={() => sharePost(post)}
>
  <Send class="action-icon" size={19} strokeWidth={1.8} />
</button>

                </div>
{#if interactionError}
  <p class="interaction-error" role="alert">
    {interactionError}
  </p>
{/if}
              </div>
            </article>
          {/each}

          </div>

          {#if timelineError}
            <p class="timeline-error">{timelineError}</p>
          {/if}

{#if activeNav === 'Home' && nextMaxId}
            <div class="load-more-container">
              <button
                class="load-more-button"
                type="button"
                onclick={loadMorePosts}
                disabled={loadingMorePosts}
              >
                {loadingMorePosts ? 'Loading…' : 'Load more posts'}
              </button>
            </div>
                    {/if}

          {#if activeNav === 'Bookmarks' && bookmarksNextMaxId}
            <div class="load-more-container">
              <button
                class="load-more-button"
                type="button"
                onclick={loadMoreBookmarks}
                disabled={loadingBookmarks}
              >
                {loadingBookmarks ? 'Loading…' : 'Load more bookmarks'}
              </button>
            </div>
          {/if}

          {#if activeNav === 'Lists' && listNextMaxId}
            <div class="load-more-container">
              <button
                class="load-more-button"
                type="button"
                onclick={loadMoreListPosts}
                disabled={loadingListPosts}
              >
                {loadingListPosts ? 'Loading…' : 'Load more posts'}
              </button>
            </div>
          {/if}

          {#if activeNav === 'Hashtags' && hashtagNextMaxId}
            <div class="load-more-container">
              <button
                class="load-more-button"
                type="button"
                onclick={loadMoreHashtagPosts}
                disabled={loadingHashtagPosts}
              >
                {loadingHashtagPosts ? 'Loading…' : 'Load more posts'}
              </button>
            </div>
          {/if}

        {:else if activeNav === 'Compose'}
  <div class="compose-view">
    <div class="compose-card">
      <div class="compose-heading">
<h2>
  {editingPost
    ? 'Edit post'
    : replyingTo
      ? 'Write a reply'
      : quotingPost
        ? 'Quote a post'
        : 'Write a post'}
</h2>
        <p>{editingPost ? 'Update your post.' : replyingTo ? `Replying to ${replyingTo.name}` : "Share what's on your mind."}</p>
      </div>

      {#if editingPost}
        <div class="reply-context">
          <div>
            <strong>Editing your post</strong>
            <span>Existing media attachments will be kept.</span>
          </div>
          <button
            class="reply-cancel"
            type="button"
            onclick={() => {
              editingPost = null;
              existingMediaIds = [];
              composeText = '';
              contentWarning = '';
              showContentWarning = false;
            }}
          >
            Cancel edit
          </button>
        </div>
      {/if}
{#if quotingPost}
  <div class="reply-context">
    <div>
      <strong>Quoting {quotingPost.name}</strong>
      <span>{quotingPost.handle}</span>
    </div>
    <button
      class="reply-cancel"
      type="button"
      onclick={() => quotingPost = null}
    >
      Remove quote
    </button>
  </div>

  <div class="quote-preview">
    {@html quotingPost.content}
  </div>
{/if}
      {#if replyingTo}
        <div class="reply-context">
          <div>
            <strong>{replyingTo.name}</strong>
            <span>{replyingTo.handle}</span>
          </div>
          <button
            class="reply-cancel"
            type="button"
            onclick={() => {
              replyingTo = null;
              composeText = '';
            }}
          >
            Cancel reply
          </button>
        </div>
      {/if}

      <div class="visibility-control">
  <label for="post-visibility">Who can see this?</label>
  <select
    id="post-visibility"
    bind:value={composeVisibility}
    class="visibility-select"
    disabled={!!editingPost}
  >
    <option value="public">Public</option>
    <option value="unlisted">Unlisted</option>
    <option value="private">Followers only</option>
    <option value="direct">Direct</option>
  </select>
  {#if editingPost}
    <p class="edit-visibility-note">Visibility cannot be changed when editing a post.</p>
  {/if}
</div>
<div class="cw-control">
  <label class="cw-toggle">
    <input
      type="checkbox"
      bind:checked={showContentWarning}
    />
    <span>Add a content warning</span>
  </label>

  {#if showContentWarning}
    <input
      class="cw-input"
      type="text"
      bind:value={contentWarning}
      placeholder="What is this post about?"
      aria-label="Content warning"
    />
  {/if}
</div>
      <textarea
  class="compose-textarea"
  bind:this={composeTextarea}
  bind:value={composeText}
  placeholder="What's happening?"
  rows="6"
></textarea>
<div class="attachment-toolbar">
  <label class="attachment-button" for="compose-attachments">
    <ImagePlus size={18} />
    <span>Add media</span>
  </label>

  <input
    id="compose-attachments"
    type="file"
    accept="image/*,video/*"
    multiple
    disabled={pollEnabled}
    onchange={handleAttachmentChange}
    hidden
  />
  <button
  class="attachment-button emoji-button"
  type="button"
  onclick={() => emojiPickerOpen = !emojiPickerOpen}
>
  <Smile size={18} strokeWidth={1.8} />
<span>Custom emoji</span>
</button>
 <button
    class="attachment-button"
    type="button"
    onclick={insertCodeBlock}
  >
       <Code size={18} strokeWidth={1.8} />
    <span>Code block</span>
  </button>

  <button
    class="attachment-button"
    type="button"
    disabled={!!editingPost || !!replyingTo || !!quotingPost || composeAttachments.length > 0}
    onclick={() => {
      pollEnabled = !pollEnabled;
      if (pollEnabled) {
        pollOptions = ['', ''];
        pollMultiple = false;
        pollDuration = 86400;
      }
    }}
      >
    <ChartNoAxesColumn size={18} strokeWidth={1.8} />
    <span>{pollEnabled ? 'Remove poll' : 'Add poll'}</span>
  </button>
</div>

{#if pollEnabled}
  <div class="poll-editor">
    <div class="poll-options">
      {#each pollOptions as option, index}
        <div class="poll-option">
          <input
            class="cw-input"
            type="text"
            bind:value={pollOptions[index]}
            maxlength="50"
            placeholder={`Option ${index + 1}`}
            aria-label={`Poll option ${index + 1}`}
          />

          <button
            class="attachment-button"
            type="button"
            disabled={pollOptions.length <= 2}
            onclick={() => {
              pollOptions = pollOptions.filter((_, i) => i !== index);
            }}
          >
            Remove
          </button>
        </div>
      {/each}
    </div>

    <button
      class="attachment-button"
      type="button"
      disabled={pollOptions.length >= 4}
      onclick={() => pollOptions = [...pollOptions, '']}
    >
      Add option
    </button>

    <label class="cw-toggle">
      <input
        type="checkbox"
        bind:checked={pollMultiple}
      />
      <span>Allow multiple choices</span>
    </label>

    <div class="poll-duration">
      <label for="poll-duration">Poll duration</label>
      <select
        id="poll-duration"
        class="visibility-select"
        bind:value={pollDuration}
      >
        <option value={300}>5 minutes</option>
        <option value={1800}>30 minutes</option>
        <option value={3600}>1 hour</option>
        <option value={21600}>6 hours</option>
        <option value={86400}>1 day</option>
        <option value={604800}>7 days</option>
      </select>
    </div>
  </div>
{/if}

{#if emojiPickerOpen}
  <div class="emoji-picker">
    <input
      class="emoji-search"
      type="search"
      bind:value={emojiSearch}
      placeholder="Search custom emojis..."
      aria-label="Search custom emojis"
    />

    {#if customEmojis.filter(emoji =>
      emoji.shortcode.toLowerCase().includes(emojiSearch.toLowerCase()) ||
      (emoji.category ?? '').toLowerCase().includes(emojiSearch.toLowerCase())
    ).length > 0}
      {#each [...new Set(
        customEmojis
          .filter(emoji =>
            emoji.shortcode.toLowerCase().includes(emojiSearch.toLowerCase()) ||
            (emoji.category ?? '').toLowerCase().includes(emojiSearch.toLowerCase())
          )
          .map(emoji => emoji.category || 'Other')
      )] as category}
        <div class="emoji-category">
          <h3>{category}</h3>
          <div class="emoji-grid">
            {#each customEmojis.filter(emoji =>
              (emoji.category || 'Other') === category &&
              (
                emoji.shortcode.toLowerCase().includes(emojiSearch.toLowerCase()) ||
                category.toLowerCase().includes(emojiSearch.toLowerCase())
              )
            ) as emoji}
              <button
                type="button"
                class="emoji-option"
                title={`:${emoji.shortcode}:`}
                aria-label={`Insert ${emoji.shortcode}`}
                onclick={() => insertCustomEmoji(emoji.shortcode)}
              >
                <img src={emoji.static_url} alt={emoji.shortcode} />
                <span>:{emoji.shortcode}:</span>
              </button>
            {/each}
          </div>
        </div>
      {/each}
    {:else}
      <p class="emoji-empty">No matching emojis found.</p>
    {/if}
  </div>
{/if}

<div class="compose-footer">
  <span class="character-count">
    {composeText.length} characters
  </span>

  <button
  class="compose-submit"
disabled={
  !composeText.trim() ||
  publishing ||
  (pollEnabled && (
    pollOptions.length < 2 ||
    pollOptions.length > 4 ||
    pollOptions.some(option => !option.trim()) ||
    new Set(
