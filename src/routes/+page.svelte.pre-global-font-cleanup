function insertCustomEmoji(shortcode: string) {
  const textarea = document.querySelector(
    '.compose-textarea'
  ) as HTMLTextAreaElement | null;

  if (!textarea) return;

  const start = textarea.selectionStart;
  const end = textarea.selectionEnd;
  const emoji = `:${shortcode}:`;

  composeText =
    composeText.slice(0, start) +
    emoji +
    composeText.slice(end);

  requestAnimationFrame(() => {
    textarea.focus();
    textarea.setSelectionRange(
      start + emoji.length,
      start + emoji.length
    );
  });

  emojiPickerOpen = false;
  emojiSearch = '';
}
function insertCodeBlock() {
  const textarea = composeTextarea;

  if (!textarea) return;

  const start = textarea.selectionStart;
  const end = textarea.selectionEnd;
  const selectedText = composeText.slice(start, end);

  const codeBlock = selectedText
    ? `\`\`\`\n${selectedText}\n\`\`\``
    : '```\n\n```';

  composeText =
    composeText.slice(0, start) +
    codeBlock +
    composeText.slice(end);

  const cursorPosition = start + (selectedText ? codeBlock.length : 4);

  requestAnimationFrame(() => {
    textarea.focus();
    textarea.setSelectionRange(cursorPosition, cursorPosition);
  });
}

