async function voteInPoll(postId: string) {
  const post = findPost(postId);
  if (!post?.poll) return;

  const poll = post.poll;
  const choices = selectedPollOptions[poll.id] ?? [];

  if (
    choices.length === 0 ||
    votingPolls.includes(poll.id) ||
    poll.voted ||
    poll.expired
  ) {
    return;
  }

  votingPolls = [...votingPolls, poll.id];
  pollErrors = { ...pollErrors, [poll.id]: '' };

  try {
    const response = await fetch(
      `/api/polls/${encodeURIComponent(poll.id)}/votes`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ choices })
      }
    );

    const result = await response.json().catch(() => null);

    if (!response.ok) {
      throw new Error(
        result?.error || 'Could not submit your vote.'
      );
    }

    updatePost(postId, item => ({
      ...item,
      poll: result.poll
    }));

    selectedPollOptions = {
      ...selectedPollOptions,
      [poll.id]: []
    };
  } catch (error) {
    pollErrors = {
      ...pollErrors,
      [poll.id]:
        error instanceof Error
          ? error.message
          : 'Could not submit your vote.'
    };
  } finally {
    votingPolls = votingPolls.filter(
      id => id !== poll.id
    );
  }
}

