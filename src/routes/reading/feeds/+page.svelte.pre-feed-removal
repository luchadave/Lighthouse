<script lang="ts">
  import { onMount } from 'svelte';

  type Feed = {
    id: number;
    url: string;
    title: string;
    fetched_at: number;
    error: string | null;
  };

  let feeds: Feed[] = $state([]);
  let feedUrl = $state('');
  let loading = $state(false);
  let message = $state('');
  let error = $state('');

  async function loadFeeds() {
    const response = await fetch('/api/reading/feeds');

    if (!response.ok) {
      error = 'Unable to load subscriptions.';
      return;
    }

    const data = await response.json();
    feeds = data.feeds;
  }

  async function addFeed() {
    if (!feedUrl.trim() || loading) return;

    loading = true;
    message = '';
    error = '';

    try {
      const response = await fetch('/api/reading/feeds', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: feedUrl.trim() })
      });

      const data = await response.json();

      if (!response.ok) {
        error = data.error || 'Unable to add subscription.';
        return;
      }

      message = data.feed.error
        ? `Subscription added, but fetching failed: ${data.feed.error}`
        : `Added ${data.feed.title}`;

      feedUrl = '';
      await loadFeeds();
    } catch {
      error = 'Unable to connect to Lighthouse.';
    } finally {
      loading = false;
    }
  }

  onMount(() => {
    loadFeeds();
  });
</script>

<svelte:head>
  <title>Feeds — Lighthouse</title>
</svelte:head>

<main class="reading-page">
  <h1>Feeds</h1>
  <p>Manage your RSS subscriptions.</p>

  <form onsubmit={(event) => {
    event.preventDefault();
    addFeed();
  }}>
    <input
      type="url"
      bind:value={feedUrl}
      placeholder="https://example.com/feed.xml"
      aria-label="RSS feed URL"
      required
    />

    <button type="submit" disabled={loading}>
      {loading ? 'Adding…' : 'Add Feed'}
    </button>
  </form>

  {#if message}
    <p class="success">{message}</p>
  {/if}

  {#if error}
    <p class="error">{error}</p>
  {/if}

  <h2>Subscriptions</h2>

  {#if feeds.length === 0}
    <p>No subscriptions yet.</p>
  {:else}
    {#each feeds as feed (feed.id)}
      <article class="feed">
        <strong>{feed.title}</strong>
        <small>{feed.url}</small>

        {#if feed.error}
          <p class="error">{feed.error}</p>
        {/if}
      </article>
    {/each}
  {/if}
</main>

